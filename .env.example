# Game server
HOST=127.0.0.1
PORT=8787
DSH_GAME_DATA_DIR=./data
GAME_LLM_CALLS_MAX=8
GAME_DECISION_TIMEOUT_MS=90000

# The game server posts only {gameId, gameType} to the local QQ bridge.
# Use a separate random secret (at least 32 characters); never place it in prompts.
GAME_BRIDGE_URL=http://127.0.0.1:3100/internal/game/turn
GAME_BRIDGE_SECRET=
GAME_KEYTURN_TIMEOUT_MS=90000

# Shared local secret. Generate a random 32+ character value and keep it out of source control.
GAME_WORKER_TOKEN=
GAME_WORKER_HOST=127.0.0.1
GAME_WORKER_PORT=8788
GAME_WORKER_URL=http://127.0.0.1:8788
GAME_HUB_URL=http://127.0.0.1:8787

# Route A direct OpenAI-compatible Chat Completions endpoint.
# Use an API endpoint/key you are authorized to use; DSH desktop sign-in is not an API key.
GAME_MODEL_API_URL=
GAME_MODEL_API_KEY=
GAME_MODEL_NAME=
GAME_PERSONA=你是小鲸鱼，正在和用户下五子棋。自然、简短地替自己选择一步。
